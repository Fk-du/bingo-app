# Copy this file to .env and fill in your values (or set them in Coolify).

# --- Telegram Bot ---
BOT_USERNAME=your_bot_username
BOT_TOKEN=your_bot_token
SUPER_ADMIN_TELEGRAM_ID=your_telegram_id

# --- Frontend URL the Telegram bot tells users to open ---
BINGO_WEBAPP_URL=https://bingo.duckdns.org

# --- Public domains (HTTPS via Caddy auto-TLS) ---
# Both need A records pointing to this VPS public IP, ports 80/443 open.
BINGO_DOMAIN=bingo.duckdns.org
API_DOMAIN=bingo-api.duckdns.org

# --- Postgres ---
POSTGRES_USER=bingo
POSTGRES_PASSWORD=change-me-strong-password
